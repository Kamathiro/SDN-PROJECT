{
  "rules": {
    ".read": false,
    ".write": false,
    "detections": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".validate": "newData.hasChildren(['ts','src_ip','prob','label'])",
        "prob": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        }
      }
    },
    "status": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "commands": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists() && !data.exists()",
        ".validate": "newData.hasChildren(['action','src_ip','by','ts','done'])",
        "action": {
          ".validate": "newData.val() == 'block' || newData.val() == 'unblock'"
        },
        "src_ip": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}(\\.[0-9]{1,3}){3}$/)"
        },
        "by": {
          ".validate": "newData.isString()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "done": {
          ".validate": "newData.val() == false"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid"
      }
    }
  }
}
